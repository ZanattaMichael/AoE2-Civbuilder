{
  "name": "aoe2-civbuilder",
  "version": "1.0.0",
  "description": "Age of Empires II civilization builder and drafting tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZanattaMichael/AoE2-Civbuilder.git"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "build:native": "bash modding/scripts/build.sh",
    "build:native:clean": "bash modding/scripts/build.sh --clean",
    "docker:build": "docker build -t aoe2-civbuilder:local .",
    "docker:run": "docker compose up --build",
    "verify": "npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "body-parser": "^1.20.3",
    "canvas": "^3.2.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pug": "^3.0.3",
    "seedrandom": "^3.0.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.4",
    "cookie-signature": "^1.2.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jquery": "^3.7.1",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
