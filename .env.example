# Copy to .env and adjust. Never commit the real .env.

# --- Required in production ---
# Signs the seat cookies that authorize draft actions. Without a strong value
# here, players can forge each other's seats.
# Generate with: openssl rand -hex 32
COOKIE_SECRET=

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Absolute path the app treats as its root. Set to /app inside the container.
APP_DIR=/app

# Path prefix the app is mounted under, and the externally reachable URL used
# to build draft invite links.
BASE_PATH=/civbuilder
PUBLIC_URL=http://localhost:4000/civbuilder

# Number of reverse proxies in front of the app, for correct client IPs.
TRUST_PROXY_HOPS=1

# Comma-separated browser origins allowed to call the API. Empty = same-origin.
CORS_ORIGINS=

# Emit CSP's upgrade-insecure-requests, so the browser rewrites this origin's
# http:// subresource requests to https://. Leave it on behind a TLS-terminating
# proxy — the normal deployment. Set it to false only when the app is genuinely
# reached over plain HTTP by hostname, where the upgrade would make every
# stylesheet and script fail the TLS handshake and the pages render dead.
# (Loopback is exempt from the upgrade, so localhost never sees the difference.)
CSP_UPGRADE_INSECURE_REQUESTS=true

# --- Limits ---
BODY_LIMIT=20mb
MOD_RATE_WINDOW_MS=900000
MOD_RATE_MAX=10
GENERAL_RATE_WINDOW_MS=900000
GENERAL_RATE_MAX=300
COMMAND_TIMEOUT_MS=300000

# --- Logging ---
# silent | error | warn | info | debug
LOG_LEVEL=info
